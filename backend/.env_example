APP_NAME=LilaPHP
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
HTTP_PORT=8080
PROD_HTTP_PORT=80

# -----------------------------------------------------------------------------
# Database Configuration
# LilaPHP supports multi-driver PDO: 'mysql' (default), 'sqlite', or 'pgsql'
# -----------------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=lilaphp
DB_USER=root
DB_PASSWORD=secret
# For SQLite, set DB_TYPE=sqlite and optional custom DB_FILE:
# DB_TYPE=sqlite
# DB_FILE=backend/database/app.sqlite

# -----------------------------------------------------------------------------
# Redis & Dual-Tier Cache
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_DRIVER=apcu
DB_CACHE_DRIVER=file

# -----------------------------------------------------------------------------
# Security & Rate Limiting
# -----------------------------------------------------------------------------
APP_KEY=base64:XG8d2Lq1mNkP9xW8Z3vK7tY2eR5uI1oP4aS7dF0gH3j=
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT=200
RATE_LIMIT_WINDOW=60
LOG_ENABLED=false
DEBUG_LOGGING_ENABLED=false