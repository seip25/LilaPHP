# LilaPHP Environment Configuration Example
APP_ENV=development
APP_NAME=lilaphp
APP_DEBUG=true
APP_URL=http://localhost:8080

# HTTP Port (Dynamic for Docker & Nginx)
HTTP_PORT=8080
PROD_HTTP_PORT=80

# Database Configuration (MySQL only)
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=lilaphp
DB_USER=root
DB_PASSWORD=root

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache Settings (apcu, redis, memory)
CACHE_DRIVER=apcu
DB_CACHE_DRIVER=redis

# Security
APP_KEY=base64:LilaPHPDefaultSecretKey32BytesLong==
CORS_ALLOWED_ORIGINS=*
