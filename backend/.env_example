# LilaPHP Environment Configuration
APP_ENV=development
APP_NAME=lilaphp
APP_DEBUG=true
APP_URL=http://localhost:8080

# HTTP Port (Dynamic for Docker & Nginx)
HTTP_PORT=8080
PROD_HTTP_PORT=80

# Database Configuration (MySQL only)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lilaphp
DB_USER=lilaphp
DB_PASSWORD=secret

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache Settings (apcu, redis, memory)
CACHE_DRIVER=apcu
DB_CACHE_DRIVER=redis

# Security & Rate Limiting
# RATE_LIMIT: Max requests per window. Set to false, 0, or none to disable rate limiting (ideal for benchmarks/load tests)
RATE_LIMIT=200
RATE_LIMIT_WINDOW=60
APP_KEY=base64:9bzXCxl7sBzH6XOAlPOO7Ui/1toX3fh0t9gfFa64Lhw=
CORS_ALLOWED_ORIGINS=*

# Logger file info 
LOG_ENABLED=false