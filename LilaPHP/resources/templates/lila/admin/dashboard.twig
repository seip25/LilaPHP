{% extends 'base.twig' %}

{% block title %}Admin Dashboard - LilaPHP
{% endblock %}

{% block content %}
	<div
		class="min-h-screen bg-gray-50 dark:bg-slate-900 flex overflow-hidden">
		<!-- Mobile Sidebar Overlay -->
		<div id="sidebar-overlay" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden transition-opacity"></div>

		<!-- Sidebar -->
		<aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-white dark:bg-slate-800 border-r border-gray-200 dark:border-slate-700 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out lg:static lg:block overflow-y-auto">
			<div class="p-6">
				<a href="/Admin/" class="flex items-center gap-2 font-bold text-xl text-slate-900 dark:text-white mb-8">
					<div class="w-8 h-8 rounded-lg bg-primary-600 flex items-center justify-center text-white text-sm">L</div>
					<span>Admin Portal</span>
				</a>

				<nav class="space-y-1">
					<p class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Models</p>
					{% for model in models %}
						{% set modelName = model|split('\\')|last %}
						<a href="?model={{ model|url_encode }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors {{ activeModel == model ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-600 dark:text-primary-400' : 'text-slate-600 dark:text-slate-400 hover:bg-gray-50 dark:hover:bg-slate-700/50' }}">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
							</svg>
							{{ modelName }}
						</a>
					{% endfor %}
				</nav>
			</div>

			<div class="absolute bottom-0 w-64 p-6 border-t border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-500 text-xs font-bold uppercase">
						{{ user|first }}
					</div>
					<div class="flex-1 overflow-hidden">
						<p class="text-sm font-medium text-slate-900 dark:text-white truncate">{{ user }}</p>
						<p class="text-xs text-slate-500 truncate">Administrator</p>
					</div>
				</div>
				<a href="?logout=true" class="flex items-center gap-2 text-sm text-red-600 hover:text-red-500 font-medium">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
					</svg>
					Logout
				</a>
			</div>
		</aside>

		<!-- Main Content -->
		<main
			class="flex-1 overflow-y-auto">
			<!-- Top Bar -->
			<header class="bg-white dark:bg-slate-800 border-b border-gray-200 dark:border-slate-700 h-16 flex items-center justify-between px-8 sticky top-0 z-10">
				<h1 class="text-lg font-semibold text-slate-900 dark:text-white">
					Dashboard
					{% if activeModel %}
						<span class="text-slate-400 mx-2">/</span>
						{{ activeModel|split('\\')|last }}
					{% endif %}
				</h1>

				<div class="flex items-center gap-4">
					<div class="flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium {{ debug ? 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400' : 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' }}">
						<span class="w-2 h-2 rounded-full {{ debug ? 'bg-yellow-500' : 'bg-green-500' }}"></span>
						{{ debug ? 'Debug Mode' : 'Production' }}
					</div>

					{% if activeModel %}
						<!-- Search Form -->
						<form action="" method="GET" class="hidden md:flex relative group">
							<input type="hidden" name="model" value="{{ activeModel }}">
							<input type="text" name="q" value="{{ pagination.q }}" placeholder="Search {{ activeModel|split('\\')|last }}..." class="w-64 pl-9 pr-4 py-1.5 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-lg text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500 transition-all">
							<div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-slate-400">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
								</svg>
							</div>
						</form>
					{% endif %}

					<!-- Simple mobile menu toggle -->
					<button id="mobile-sidebar-toggle" class="lg:hidden p-2 text-slate-600 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-700 rounded-md">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
						</svg>
					</button>
				</div>
			</header>

			<div class="p-8">
				{% if activeModel %}
					<div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
						<div class="p-6 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between">
							<h2 class="font-bold text-slate-900 dark:text-white">{{ activeModel|split('\\')|last }}
								Records</h2>
							<span class="text-xs text-slate-500">{{ data|length }}
								results found</span>
						</div>

						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse">
								<thead>
									<tr class="bg-slate-50 dark:bg-slate-900/50">
										{% if data|length > 0 %}
											{% for key, val in data[0] %}
												<th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">{{ key }}</th>
											{% endfor %}
										{% endif %}
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200 dark:divide-slate-700">
									{% for row in data %}
										<tr class="hover:bg-gray-50 dark:hover:bg-slate-700/30 transition-colors">
											{% for key, val in row %}
												<td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">
													{% if val is iterable %}
														<span class="text-xs bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded">Array/Object</span>
													{% else %}
														{{ val|length > 30 ? val|slice(0, 30) ~ '...' : val }}
													{% endif %}
												</td>
											{% endfor %}
										</tr>
									{% else %}
										<tr>
											<td colspan="100" class="px-6 py-12 text-center text-slate-500 italic">No records found.</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>

						{% if pagination.pages > 1 %}
							<!-- Pagination -->
							<div class="p-4 border-t border-gray-200 dark:border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-50 dark:bg-slate-900/30">
								<div class="text-[10px] text-slate-500 font-medium">
									Showing
									<span class="text-slate-900 dark:text-white">{{ data|length }}</span>
									of
									<span class="text-slate-900 dark:text-white">{{ pagination.total }}</span>
									entries
								</div>
								<div class="flex items-center gap-1">
									{% if pagination.current > 1 %}
										<a href="?model={{ activeModel|url_encode }}&q={{ pagination.q|url_encode }}&page={{ pagination.current - 1 }}" class="p-2 border border-gray-200 dark:border-slate-700 rounded-lg hover:bg-white dark:hover:bg-slate-800 text-slate-500 transition-colors">
											<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
											</svg>
										</a>
									{% endif %}

									<div class="flex items-center gap-1 mx-10">
										{% for i in 1..pagination.pages %}
											{% if pagination.pages <= 7 or (i == 1 or i == pagination.pages or (i >= pagination.current - 1 and i <= pagination.current + 1)) %}
												<a href="?model={{ activeModel|url_encode }}&q={{ pagination.q|url_encode }}&page={{ i }}" class="min-w-[32px] h-8 flex items-center justify-center rounded-lg text-xs font-medium transition-all {{ i == pagination.current ? 'bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-white dark:hover:bg-slate-800 border border-transparent hover:border-gray-200 dark:hover:border-slate-700' }}">
													{{ i }}
												</a>
											{% elseif (i == 2 and pagination.current > 4) or (i == pagination.pages - 1 and pagination.current < pagination.pages - 3) %}
												<span class="text-slate-400">...</span>
											{% endif %}
										{% endfor %}
									</div>

									{% if pagination.current < pagination.pages %}
										<a href="?model={{ activeModel|url_encode }}&q={{ pagination.q|url_encode }}&page={{ pagination.current + 1 }}" class="p-2 border border-gray-200 dark:border-slate-700 rounded-lg hover:bg-white dark:hover:bg-slate-800 text-slate-500 transition-colors">
											<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
											</svg>
										</a>
									{% endif %}
								</div>
							</div>
						{% endif %}
					</div>
				{% else %}
					<div class="flex flex-col items-center justify-center p-20 text-center">
						<div class="w-20 h-20 bg-primary-50 dark:bg-primary-900/20 rounded-full flex items-center justify-center text-primary-600 mb-6">
							<svg class="w-10 h-10" fill="none" stroke="currentColor" viewbox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
							</svg>
						</div>
						<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Welcome to Admin Dashboard</h2>
						<p class="text-slate-600 dark:text-slate-400 max-w-sm">Select a model from the left sidebar to view its data and manage records.</p>
					</div>
				{% endif %}
			</div>
		</main>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
const toggle = document.getElementById('mobile-sidebar-toggle');
const sidebar = document.getElementById('admin-sidebar');
const overlay = document.getElementById('sidebar-overlay');

const toggleSidebar = () => {
sidebar.classList.toggle('-translate-x-full');
overlay.classList.toggle('hidden');
};

toggle.addEventListener('click', toggleSidebar);
overlay.addEventListener('click', toggleSidebar);
});
	</script>

{% endblock %}
