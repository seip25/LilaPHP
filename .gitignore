# LilaPHP Root gitignore

# Composer dependencies & locks
vendor/
composer.lock

# Environment configurations
.env
backend/.env

# Core framework cache & precompiled static exports
_core/cache/*
!_core/cache/.gitkeep

# Application & CLI logs
_core/logs/*
!_core/logs/.gitkeep
*.log

# Docker runtime volumes & local data
docker/mysql/data/
docker/redis/data/
docker/*/logs/

# Local databases
*.sqlite
*.sqlite3
*.db

# OS & IDE generated files
.DS_Store
Thumbs.db
.idea/
.vscode/
test/
node_modules/
frontend/js/.vite/
package-lock.json
/tests
frontend/js/test.js
