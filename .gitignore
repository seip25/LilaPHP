# LilaPHP Root gitignore
vendor/
node_modules/
app/node_modules/
package-lock.json
app/package-lock.json
composer.lock
.env
app/.env
.DS_Store

# Assets / frontend build output
assets/build/
assets/cache/
assets/js/spa.min.js
public/build/

# App local logs, caches, and databases
app/logs/*.log
app/cache/*.php
app/cache/env_cache.php
app/cache/schema_cache.php
app/cache/model_cache.php
app/cache/route_di_cache.php
app/cache/route_attribute_cache.php
app/*.sqlite