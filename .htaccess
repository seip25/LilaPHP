<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Ensure RewriteBase matches the project folder if not in root
    # RewriteBase /LilaPHP/

    # Force trailing slash for virtual language routes to prevent mod_dir from stripping the lang prefix
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([a-z]{2}(?:-[a-z]{2})?)/(.+)$ %{REQUEST_URI}/ [L,R=301]

    # SEO friendly language prefixing
    # Matches /es/..., /en/..., /pt-br/... etc.
    # Captures the ISO code (2 letters) or pt-br format
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z]{2}(?:-[a-z]{2})?)/(.*)$ $2 [L,QSA]
    
    # Handle the case where ONLY the language is provided (e.g. /es)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z]{2}(?:-[a-z]{2})?)$ index.php [L,QSA]
</IfModule>
