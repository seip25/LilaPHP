<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/ico"
      href="{{ image('img/lila.png', 40, 0, 70, 'ico') }}"
    />
    <title>{{ title }}</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: "media",
        theme: {
          extend: {
            fontFamily: {
              sans: ["Inter", "sans-serif"],
            },
            colors: {
              primary: {
                50: "#eef2ff",
                100: "#e0e7ff",
                500: "#6366f1",
                600: "#4f46e5",
                700: "#4338ca",
              },
            },
          },
        },
      };
    </script>
  </head>
  <body
    class="bg-gray-50 text-slate-800 antialiased dark:bg-slate-900 dark:text-slate-300 min-h-screen flex flex-col"
  >
    <main class="flex-grow container mx-auto px-4 py-12 text-center">
      <h1
        class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4"
      >
        {{ translate("welcome") }}
      </h1>

      <p
        class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed mb-10"
      >
        {{ translate("intro_text") }}
      </p>

      <section
        class="max-w-3xl mx-auto bg-white dark:bg-slate-800 rounded-2xl shadow-sm b p-8 mb-8"
      >
        <h2
          class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex justify-center items-center gap-2 text-center"
        >
          <span>🚀</span> {{ translate("features_title") }}
        </h2>

        <ul class="grid md:grid-cols-2 gap-3 text-left">
          <li
            class="flex items-center gap-2 text-slate-600 dark:text-slate-400"
          >
            <svg
              class="w-5 h-5 text-green-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            {{ translate("feature_minify") }}
          </li>
          <li
            class="flex items-center gap-2 text-slate-600 dark:text-slate-400"
          >
            <svg
              class="w-5 h-5 text-green-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            {{ translate("feature_seo") }}
          </li>
          <li
            class="flex items-center gap-2 text-slate-600 dark:text-slate-400"
          >
            <svg
              class="w-5 h-5 text-green-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            {{ translate("feature_middlewares") }}
          </li>
          <li
            class="flex items-center gap-2 text-slate-600 dark:text-slate-400"
          >
            <svg
              class="w-5 h-5 text-green-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            {{ translate("feature_validation") }}
          </li>
          <li
            class="flex items-center gap-2 text-slate-600 dark:text-slate-400"
          >
            <svg
              class="w-5 h-5 text-green-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            {{ translate("feature_security") }}
          </li>
          <li
            class="flex items-center gap-2 text-slate-600 dark:text-slate-400"
          >
            <svg
              class="w-5 h-5 text-green-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            {{ translate("feature_routing") }}
          </li>
          <li
            class="flex items-center gap-2 text-slate-600 dark:text-slate-400"
          >
            <svg
              class="w-5 h-5 text-green-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            {{ translate("feature_compatibility") }}
          </li>
        </ul>
        <div class="flex justify-center mt-4">
          <a
            href="https://seip25.github.io/LilaPHP"
            target="_blank"
            class="text-blue-600 dark:text-blue-400 underline"
            >LilaPHP Docs</a
          >
        </div>
        <div class="flex justify-center mt-4">
          <a
            href="?debug=true"
            target="_blank"
            class="text-blue-600 dark:text-blue-400 underline"
            >LilaPHP Debug monitoring</a
          >
        </div>
      </section>

      <section
        class="max-w-3xl mx-auto bg-white dark:bg-slate-800 rounded-2xl shadow-sm p-8 mb-8 text-center"
      >
        <h3
          class="text-xl font-bold text-slate-900 dark:text-white mb-2 flex items-center justify-center gap-2"
        >
          React + LilaPHP
        </h3>
        <p class="text-slate-600 dark:text-slate-400">
          {{ translate("try_react") }}
        </p>
        <div
          class="flex flex-col gap-4 justify-center items-center text-center mt-4 mb-4"
        >
          <code class="text-slate-600 dark:text-slate-900"
            >1. php app/cli.php react:install</code
          >
          <code class="text-slate-600 dark:text-slate-900">2. cd app</code>
          <code class="text-slate-600 dark:text-slate-900">3. npm install</code>
          <code class="text-slate-600 dark:text-slate-900">4. npm run dev</code>
        </div>
        <div
          class="flex flex-col gap-4 justify-center items-center text-center mt-4 mb-4"
        >
          <a
            href="{{ url('/?page=react') }}"
            class="text-blue-500 dark:text-blue-400 underline"
            >{{ translate("view_react_island") }}</a
          >
          <a
            href="{{ url('/?page=react-page') }}"
            class="mt-4 text-blue-500 dark:text-blue-400 underline"
            >{{ translate("view_react") }}</a
          >
        </div>
      </section>

      <section
        class="max-w-3xl mx-auto bg-white dark:bg-slate-800 rounded-2xl shadow-sm p-8 mb-8 text-center"
      >
        <h2
          class="text-xl font-bold text-slate-900 dark:text-white mb-2 flex items-center justify-center gap-2"
        >
          <span>⭐</span> {{ translate("support_title") }}
        </h2>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          {{ translate("support_text") }}
        </p>
        <a
          href="https://github.com/seip25/LilaPHP"
          target="_blank"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-medium text-sm rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"
            ></path>
          </svg>
          GitHub: seip25/LilaPHP
        </a>
      </section>

      <div
        class="mt-auto py-6 flex justify-center gap-6 text-sm font-medium text-slate-500 dark:text-slate-400"
      >
        <a
          href="{{ url('set-lang/?lang=eng') }}"
          class="hover:text-primary-600 transition-colors underline"
          >🇺🇸 English</a
        >
        <a
          href="{{ url('set-lang/?lang=esp') }}"
          class="hover:text-primary-600 transition-colors underline"
          >🇪🇸 Español</a
        >
        <a
          href="{{ url('set-lang/?lang=br') }}"
          class="hover:text-primary-600 transition-colors underline"
          >🇧🇷 Português</a
        >
      </div>
    </main>
  </body>
</html>
