TITLE_PROJECT="LILA PHP Framework"
DEBUG=true
VERSION_PROJECT="0.1"
VERSION_API="1"
PATH_LOGS="app/logs/" 
PATH_CACHE="app/cache/" 
PATH_LOCALES="app/locales/"
SECRET_KEY="mysecretkey"
URL_PROJECT="http://localhost" # URL for the project
LANG="en"
TRANSLATE="true"
AUTHORMETA="LilaPHP"
DESCRIPTIONMETA="Description for LilaPHP" 
KEYWORDSMETA="keywords, lila, php"

# Database Configuration
DB_PROVIDER="sqlite"
DB_NAME="lila"

