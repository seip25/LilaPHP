{% extends "base.twig" %}
{% block content %}
	<div class="min-h-screen p-6">
		<header class="mb-8 max-w-7xl mx-auto">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
				<div>
					<h1 class="text-3xl font-bold text-gray-900 dark:text-white">Request Debugger</h1>
					<p class="text-gray-500 mt-2 dark:text-slate-400">Monitoring request performance and memory usage in real-time.</p>
				</div>
				<div class="flex gap-2">
					<button class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-gray-100 dark:text-gray-900 bg-gray-900 hover:bg-gray-700 dark:hover:bg-gray-200 dark:bg-gray-100 transition-colors" onclick="clearLog()">
						Clear Log
					</button>
					<a href="{{ url('/') }}" class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-slate-600 text-sm font-medium rounded-md text-gray-700 dark:text-slate-300 bg-white dark:bg-slate-800 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">
						Back to Home
					</a>
				</div>
			</div>
		</header>

		<main
			class="max-w-7xl mx-auto">
			<!-- Stats Overview -->
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8" id="statsContainer">
				<div class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700">
					<p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Total Requests</p>
					<p class="text-2xl font-bold text-slate-900 dark:text-white" id="statTotal">0</p>
				</div>
				<div class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700">
					<p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Avg. Duration</p>
					<p class="text-2xl font-bold text-slate-900 dark:text-white" id="statAvgTime">0 ms</p>
				</div>
				<div class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700">
					<p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Max Memory</p>
					<p class="text-2xl font-bold text-slate-900 dark:text-white" id="statMaxMem">0 MB</p>
				</div>
				<div class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700">
					<p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Error Rate</p>
					<p class="text-2xl font-bold text-red-600 dark:text-red-400" id="statErrorRate">0%</p>
				</div>
			</div>

			<!-- Filters -->
			<div class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 mb-6">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
					<div class="md:col-span-2">
						<label class="block text-xs font-medium text-slate-500 uppercase mb-1">Search URI</label>
						<input type="text" id="searchInput" placeholder="Search by URI..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 dark:text-white transition-all">
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-500 uppercase mb-1">Method</label>
						<select id="methodFilter" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 dark:text-white transition-all">
							<option value="">All Methods</option>
							<option value="GET">GET</option>
							<option value="POST">POST</option>
							<option value="PUT">PUT</option>
							<option value="DELETE">DELETE</option>
						</select>
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-500 uppercase mb-1">Status</label>
						<select id="statusFilter" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 dark:text-white transition-all">
							<option value="">All Status</option>
							<option value="2">2xx Success</option>
							<option value="3">3xx Redirect</option>
							<option value="4">4xx Client Error</option>
							<option value="5">5xx Server Error</option>
						</select>
					</div>
				</div>
			</div>

			<div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
				<div class="overflow-x-auto">
					<table class="min-w-full">
						<thead class="bg-gray-50 dark:bg-slate-900/50">
							<tr>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider">Method</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider">URI</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider">Duration</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider">Memory</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider">Date</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-200 dark:divide-slate-700" id="tableBody">
							<tr id="initialLoader">
								<td colspan="6" class="px-6 py-12 text-center text-sm text-gray-500 dark:text-slate-400">
									<div class="flex flex-col items-center gap-2">
										<svg class="animate-spin h-8 w-8 text-primary-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24">
											<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
											<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
										</svg>
										<span>Loading requests...</span>
									</div>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</main>

		<script>
			let rawData = [];
let updateTimer = null;

function clearLog() {
if (confirm('Are you sure you want to clear the request log?')) {
fetch('?debug=true&clear=true').then(() => {
rawData = [];
renderData();
});
}
}

async function fetchLogs() {
try {
const response = await fetch('?debug=true&fetch=true');
rawData = await response.json();
renderData();
} catch (e) {
console.error('Error fetching logs:', e);
}
}

function renderData() {
const searchTerm = document.getElementById('searchInput').value.toLowerCase();
const methodFilter = document.getElementById('methodFilter').value;
const statusFilter = document.getElementById('statusFilter').value;

const filtered = rawData.filter(req => {
const matchesSearch = req.uri.toLowerCase().includes(searchTerm);
const matchesMethod = ! methodFilter || req.method === methodFilter;
const matchesStatus = ! statusFilter || req.response_code.toString().startsWith(statusFilter);
return matchesSearch && matchesMethod && matchesStatus;
});

updateStats(filtered);

const tbody = document.getElementById('tableBody');
if (filtered.length === 0) {
tbody.innerHTML = `
					<tr>
						<td colspan="6" class="px-6 py-12 text-center text-sm text-gray-500 dark:text-slate-400">
							${
rawData.length === 0 ? 'No requests logged yet.' : 'No requests match your filters.'
}
						</td>
					</tr>
				`;
return;
}

tbody.innerHTML = filtered.map(req => {
let statusColor = 'bg-gray-100 text-gray-800';
if (req.response_code >= 200 && req.response_code < 300) 
statusColor = 'bg-green-100 text-green-800';
 else if (req.response_code >= 300 && req.response_code < 400) 
statusColor = 'bg-blue-100 text-blue-800';
 else if (req.response_code >= 400 && req.response_code < 500) 
statusColor = 'bg-yellow-100 text-yellow-800';
 else if (req.response_code >= 500) 
statusColor = 'bg-red-100 text-red-800';


const durationColor = req.duration > 500 ? 'text-amber-600 font-semibold' : 'text-green-600';

return `
					<tr class="hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors">
						<td class="px-6 py-4 whitespace-nowrap">
							<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${statusColor}">
								${
req.response_code
}
							</span>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">
							${
req.method
}
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-slate-400">
							<div class="max-w-md truncate" title="${
req.uri
}">
								${
req.uri
}
							</div>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm ${durationColor}">
							${
req.duration.toFixed(2)
} ms
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 dark:text-slate-300">
							${
(req.memory_peak / 1024 / 1024).toFixed(2)
} MB
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-slate-400 font-mono text-xs">
							${
req.created_at
}
						</td>
					</tr>
				`;
}).join('');
}

function updateStats(data) {
document.getElementById('statTotal').innerText = data.length;

if (data.length === 0) {
document.getElementById('statAvgTime').innerText = '0 ms';
document.getElementById('statMaxMem').innerText = '0 MB';
document.getElementById('statErrorRate').innerText = '0%';
return;
}

const totalTime = data.reduce((acc, req) => acc + req.duration, 0);
const maxMem = Math.max(... data.map(req => req.memory_peak)) / 1024 / 1024;
const errors = data.filter(req => req.response_code >= 400).length;

document.getElementById('statAvgTime').innerText = (totalTime / data.length).toFixed(2) + ' ms';
document.getElementById('statMaxMem').innerText = maxMem.toFixed(2) + ' MB';
document.getElementById('statErrorRate').innerText = ((errors / data.length) * 100).toFixed(1) + '%';

const errorEl = document.getElementById('statErrorRate');
if (errors > 0) 
errorEl.classList.add('text-red-600');
 else 
errorEl.classList.remove('text-red-600');

}['searchInput', 'methodFilter', 'statusFilter'].forEach(id => {
document.getElementById(id).addEventListener('input', renderData);
});


fetchLogs();
updateTimer = setInterval(fetchLogs, 3000);
		</script>
	</div>
{% endblock %}
