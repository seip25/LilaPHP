<!DOCTYPE html>
<html lang="{{ lang }}">
	<head>
		<title>{{ title }}</title>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<meta name="description" content="{{ descriptionMeta }}"/>
		<meta name="keywords" content="{{ keywordsMeta }}"/>
		<meta name="author" content="{{ authorMeta }}"/>
		<link
		rel="icon" type="image/ico" href="{{url('favicon.ico')}}"/>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>

		<!-- Tailwind CSS -->
		<script src="https://cdn.tailwindcss.com"></script>
		<script>
			tailwind.config = {
darkMode: "media",
theme: {
extend: {
fontFamily: {
sans: ["Inter", "sans-serif"]
}

}
}
};
		</script>
		{{ hot_reload() }}
		{% block extra %}{% endblock %}
	</head>
	<body class="bg-gray-50 text-slate-800 antialiased dark:bg-slate-900 dark:text-slate-300 min-h-screen flex flex-col"> {% block content %}{% endblock %}

		</body>
	</html>
