FROM php:8.4-fpm

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    zip \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd pdo pdo_mysql zip opcache pcntl posix

RUN pecl install redis apcu \
    && docker-php-ext-enable redis apcu opcache

# Production OPcache & Preload Configuration
RUN echo "opcache.enable = 1" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.enable_cli = 1" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.memory_consumption = 256" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.interned_strings_buffer = 32" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.max_accelerated_files = 20000" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.validate_timestamps = 0" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.preload = /var/www/html/backend/preload.php" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.preload_user = www-data" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.jit_buffer_size = 128M" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.jit = tracing" >> /usr/local/etc/php/conf.d/opcache.ini

# Production PHP & FPM Optimization
RUN echo "auto_prepend_file = /var/www/html/_core/bootstrap.php" >> /usr/local/etc/php/conf.d/lila.ini && \
    echo "memory_limit = 512M" >> /usr/local/etc/php/conf.d/lila.ini && \
    echo "display_errors = Off" >> /usr/local/etc/php/conf.d/lila.ini && \
    echo "log_errors = On" >> /usr/local/etc/php/conf.d/lila.ini && \
    echo "apc.enabled = 1" >> /usr/local/etc/php/conf.d/apcu.ini && \
    echo "apc.shm_size = 128M" >> /usr/local/etc/php/conf.d/apcu.ini

# Multi-worker high performance FPM settings (static mode for maximum throughput)
RUN echo "[www]" >> /usr/local/etc/php-fpm.d/zz-docker.conf && \
    echo "pm = static" >> /usr/local/etc/php-fpm.d/zz-docker.conf && \
    echo "pm.max_children = 100" >> /usr/local/etc/php-fpm.d/zz-docker.conf && \
    echo "pm.max_requests = 1000" >> /usr/local/etc/php-fpm.d/zz-docker.conf

WORKDIR /var/www/html

COPY . .

RUN mkdir -p /var/www/html/_core/logs /var/www/html/_core/cache \
    && chown -R www-data:www-data /var/www/html/_core/logs /var/www/html/_core/cache

EXPOSE 9000
CMD ["php-fpm"]
